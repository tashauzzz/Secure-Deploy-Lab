DEV_MODE=true
FLASK_DEBUG=true

DEV_API_KEY=dev-EXAMPLE

SECRET_KEY=CHANGE_ME
ADMIN_PWHASH=scrypt:...EXAMPLE_HASH...
# MFA is disabled for the Secure Deploy Lab local demo.
# This project focuses on container/workload hardening, not MFA flow testing.
ADMIN_MFA_ENABLED=false
ADMIN_MFA_SECRET=
MFA_WINDOW=1
MFA_BUCKET=login_mfa

WINDOW_SEC=60
MAX_ATTEMPTS=5
RATE_BUCKET=login

DB_PATH=data/authlab.db

# Baseline/local mode keeps file logs for compatibility.
# Hardened/deploy mode will set LOG_TO_STDOUT=true so Docker/Kubernetes
# can collect logs without requiring a writable /app/logs directory.
LOG_TO_STDOUT=false
LOG_DIR=logs

WEB_GUESTBOOK_BUCKET=web_guestbook
WEB_GUESTBOOK_WINDOW_SEC=65
WEB_GUESTBOOK_MAX_ATTEMPTS=10

WEB_NOTES_BUCKET=web_notes
WEB_NOTES_WINDOW_SEC=30
WEB_NOTES_MAX_ATTEMPTS=60

XSS_R_STATE=safe
XSS_S_STATE=safe
MAX_MSG_LEN=500

SQLI_STATE=safe
IDOR_STATE=safe

API_AUTH_BUCKET=api_auth
API_GUESTBOOK_BUCKET=api_guestbook
API_PRODUCTS_BUCKET=api_products
API_NOTES_BUCKET=api_notes